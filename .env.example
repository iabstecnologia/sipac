# SIPAC - Configurações de Ambiente (Template)

# Django Core
SECRET_KEY=sua-chave-secreta-aqui-gerada-com-seguranca
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Módulo de Settings (config.settings.local ou config.settings.production)
DJANGO_SETTINGS_MODULE=config.settings.local

# Banco de Dados (opcional para local - por padrão usa SQLite)
# Para usar PostgreSQL em produção ou homologação:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sipac_db
DB_NAME=sipac_db
DB_USER=sipac_user
DB_PASSWORD=sipac_password
DB_HOST=localhost
DB_PORT=5432
